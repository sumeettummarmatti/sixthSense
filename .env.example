# Local development only. Copy to .env — never commit real secrets.

# --- CORE ZONE (identifiable data) ---
CORE_DB_USER=core
CORE_DB_PASSWORD=core_dev_password
CORE_DB_NAME=sixthsense_core
CORE_DB_PORT=5434
CORE_DATABASE_URL=postgresql+psycopg://core:core_dev_password@localhost:5434/sixthsense_core

# --- INSIGHT ZONE (anonymous only, separate credentials) ---
INSIGHT_DB_USER=insight
INSIGHT_DB_PASSWORD=insight_dev_password
INSIGHT_DB_NAME=sixthsense_insight
INSIGHT_DB_PORT=5433
INSIGHT_DATABASE_URL=postgresql+psycopg://insight:insight_dev_password@localhost:5433/sixthsense_insight

# --- Shared infra ---
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
