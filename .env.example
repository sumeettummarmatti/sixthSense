# Local development only. Copy to .env — never commit real secrets.

# --- CORE ZONE (identifiable data) ---
CORE_DB_USER=core
CORE_DB_PASSWORD=core_dev_password
CORE_DB_NAME=sixthsense_core
CORE_DB_PORT=5434
CORE_DATABASE_URL=postgresql+psycopg://core:core_dev_password@localhost:5434/sixthsense_core

# --- INSIGHT ZONE (anonymous only, separate credentials) ---
INSIGHT_DB_USER=insight
INSIGHT_DB_PASSWORD=insight_dev_password
INSIGHT_DB_NAME=sixthsense_insight
INSIGHT_DB_PORT=5433
INSIGHT_DATABASE_URL=postgresql+psycopg://insight:insight_dev_password@localhost:5433/sixthsense_insight

# --- Shared infra ---
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

# --- Insight: routes (P4-W1-demo-safe-routes) ---
# Walking routes come from a routing engine and are re-ranked by what is around them.
# "osrm" uses the free public server (no key; fine for dev and small demos). For the demo laptop,
# run Valhalla locally (routing-engine/README.md) and set ROUTING_PROVIDER=valhalla.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot
VALHALLA_BASE_URL=http://localhost:8002
# Point features for one area, built by: cd insight && uv run python scripts/build_area_features.py
ROUTES_AREA_FILE=data/areas/indiranagar.json
# HMAC pepper for the opaque reporter token on place reports. Generate like OTP_PEPPER.
REPORT_PEPPER=dev-only-report-pepper-change-me
# A reported spot is published (and affects routes) only after this many reports from this many
# different reporters. Lower both to 1 on a dev laptop to see a single report move a route.
PUBLISH_MIN_REPORTS=5
PUBLISH_MIN_DEVICES=3

# --- Core: sign-in (P2-W1) ---
# Pepper for HMAC(pepper, email): accounts are found by this hash, never by plaintext email.
# Generate real values with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing OTP_PEPPER later makes every existing account unreachable, so set it once per environment.
OTP_PEPPER=dev-only-pepper-change-me
TOKEN_SECRET=dev-only-token-secret-change-me

# Email for sign-in codes (and opt-in alert emails).
# Default: Mailpit, a fake inbox for local dev at http://localhost:8025. Nothing leaves your laptop.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_FROM=SixthSense <no-reply@sixthsense.local>
# Real inboxes (demo): use a team Gmail with an App password (free, ~500 emails/day).
# 1) Turn on 2-Step Verification on the Gmail account. 2) myaccount.google.com/apppasswords
# -> create one, paste the 16 characters. Then replace the block above with:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=yourteam@gmail.com
#   SMTP_PASSWORD=abcdefghijklmnop
#   SMTP_STARTTLS=true
#   SMTP_SSL=false
#   SMTP_FROM=SixthSense <yourteam@gmail.com>
# Check it: cd backend && uv run python scripts/send_test_email.py you@example.com
# Put real credentials only in your own .env, never in git.

# --- Core: trusted contacts (P2-W2) ---
# Base of the invite link the owner shares; the token is appended after "#". Placeholder until we pick a deep-link domain.
INVITE_BASE_URL=https://sixthsense.app/invite

# --- Core: alerts (P2-W4), all free ---
# Encrypts FCM tokens, Telegram chat ids and opt-in alert emails. Generate like OTP_PEPPER.
DATA_KEY=dev-only-data-key-change-me
# Base URL contacts use to open "I'm on it" links (your laptop's LAN IP or the pilot server).
PUBLIC_BASE_URL=http://localhost:8000
# Firebase Cloud Messaging (free): project id + path to the service-account JSON you download
# from Firebase console -> Project settings -> Service accounts. Never commit the JSON.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
# Telegram bot (free): create with @BotFather, paste the token and the bot's username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Core: signed alerts (P2-W6) ---
# Ed25519 seed that signs push alerts. Generate once per environment with:
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# When rotating, move the old value to ALERT_SIGNING_KEY_PREVIOUS for a while.
ALERT_SIGNING_KEY=dev-only-alert-signing-key
ALERT_SIGNING_KEY_PREVIOUS=
