[Unit]
Description=SixthSense alert worker (check-in watchdog, alert ladder)
After=docker.service network-online.target
Wants=docker.service

[Service]
WorkingDirectory=/opt/sixthsense/backend
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/root/.local/bin/uv run --no-dev arq app.worker.WorkerSettings
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
